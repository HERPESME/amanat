{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HERPESME/amanat/main/docs/registry/registry.schema.json",
  "title": "Amanat rail-semantics registry",
  "description": "What each payment rail is evidenced to permit. The discipline of the project is part of the schema: a row that is not UNVERIFIED carries a non-empty quote (whether the quote is verbatim is decided by the watcher, not by this schema); an UNVERIFIED row says neither yes nor no, so its `supported` is null; an OBSERVED row names what it was observed on; and a row is `permitted` only if it is supported AND rests on evidence usable as fact. A consumer that validates against this schema inherits those rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "license",
    "canonical_url",
    "corrections",
    "as_of",
    "tiers",
    "concepts",
    "overlays",
    "sources",
    "stores",
    "rails"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "covers",
        "quotes"
      ],
      "description": "What the data may be used for. The registry's own text is Apache-2.0; a quote is its source's text, reproduced for citation.",
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1
        },
        "covers": {
          "type": "string",
          "minLength": 1
        },
        "quotes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "canonical_url": {
      "type": "string",
      "format": "uri",
      "description": "Where the current copy of this file lives."
    },
    "corrections": {
      "type": "string",
      "format": "uri",
      "description": "Where a row that is wrong is reported. Corrections are dated and marked as corrections, never silently edited."
    },
    "as_of": {
      "description": "The latest date any row's evidence was read or measured. Deterministic: the export never reads a clock.",
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "tiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tier"
      }
    },
    "concepts": {
      "description": "The vocabulary the rails are compared in. A capability name that two or more rails use is defined here once, so the same name is the same question on every rail.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "overlays": {
      "description": "Keys that join this registry to other projects' data, and what each was checked against.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hyperswitch"
      ],
      "properties": {
        "hyperswitch": {
          "description": "Hyperswitch publishes a per-connector capability flag. A rail that is one of its connectors carries that connector's name (`hyperswitch_connector`); the mapping was checked against an unmodified, committed copy of their Connector enum at this commit.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "commit",
            "file",
            "snapshot_path",
            "snapshot_sha256",
            "checked_on"
          ],
          "properties": {
            "repo": {
              "type": "string"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "file": {
              "type": "string"
            },
            "snapshot_path": {
              "type": "string"
            },
            "snapshot_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "checked_on": {
              "$ref": "#/$defs/date"
            }
          }
        }
      }
    },
    "sources": {
      "description": "The documents the quotes were transcribed from, committed to this repository, with their SHA-256. The regulator's site refuses scripted clients, so anyone can download a circular in a browser and compare.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "stores": {
      "description": "A checkpoint (length and hash of the last line) of every evidence stream. An older export pins the history behind it: a stream that no longer extends its checkpoint has been rewritten.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/streamHead"
      }
    },
    "rails": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rail"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tierName": {
      "enum": [
        "primary",
        "observed",
        "secondary",
        "marketing",
        "unverified"
      ]
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "usable_as_fact",
        "meaning"
      ],
      "properties": {
        "tier": {
          "$ref": "#/$defs/tierName"
        },
        "usable_as_fact": {
          "type": "boolean"
        },
        "meaning": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "tier",
        "usable_as_fact",
        "environment",
        "obtained_on",
        "probe_id",
        "citation",
        "url",
        "quote",
        "notes",
        "verification",
        "observation"
      ],
      "properties": {
        "tier": {
          "$ref": "#/$defs/tierName"
        },
        "usable_as_fact": {
          "type": "boolean"
        },
        "environment": {
          "description": "What an OBSERVED row was observed on. A sandbox that forces an authorisation is not an issuer.",
          "enum": [
            "sandbox",
            "live",
            null
          ]
        },
        "obtained_on": {
          "description": "ISO date the evidence was read or measured; null where the repository does not record it.",
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "probe_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "citation": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "observation": {
          "$ref": "#/$defs/observation"
        }
      },
      "allOf": [
        {
          "description": "Only PRIMARY, OBSERVED and SECONDARY evidence is usable as fact.",
          "if": {
            "properties": {
              "tier": {
                "enum": [
                  "primary",
                  "observed",
                  "secondary"
                ]
              }
            },
            "required": [
              "tier"
            ]
          },
          "then": {
            "properties": {
              "usable_as_fact": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "usable_as_fact": {
                "const": false
              }
            }
          }
        },
        {
          "description": "Cited or unverified: there is no third state.",
          "if": {
            "properties": {
              "tier": {
                "const": "unverified"
              }
            },
            "required": [
              "tier"
            ]
          },
          "else": {
            "properties": {
              "quote": {
                "minLength": 1
              }
            }
          }
        },
        {
          "description": "An observation says what it was observed on and when it was obtained; nothing else may name an environment.",
          "if": {
            "properties": {
              "tier": {
                "const": "observed"
              }
            },
            "required": [
              "tier"
            ]
          },
          "then": {
            "properties": {
              "environment": {
                "enum": [
                  "sandbox",
                  "live"
                ]
              },
              "obtained_on": {
                "$ref": "#/$defs/date"
              }
            }
          },
          "else": {
            "properties": {
              "environment": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "capability": {
      "allOf": [
        {
          "$ref": "#/$defs/evidence"
        },
        {
          "type": "object",
          "required": [
            "name",
            "supported",
            "permitted"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "supported": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "What the source says the rail does: true or false. Null, and only null, for an UNVERIFIED row: nothing was established either way."
            },
            "permitted": {
              "description": "What the policy engine will do: true only if supported AND usable as fact. Absence of evidence is not permission."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "supported": {
                    "const": true
                  },
                  "usable_as_fact": {
                    "const": true
                  }
                },
                "required": [
                  "supported",
                  "usable_as_fact"
                ]
              },
              "then": {
                "properties": {
                  "permitted": {
                    "const": true
                  }
                }
              },
              "else": {
                "properties": {
                  "permitted": {
                    "const": false
                  }
                }
              }
            },
            {
              "description": "Unverified means unknown: an UNVERIFIED row says neither yes nor no, and every other row says one of them.",
              "if": {
                "properties": {
                  "tier": {
                    "const": "unverified"
                  }
                },
                "required": [
                  "tier"
                ]
              },
              "then": {
                "properties": {
                  "supported": {
                    "const": null
                  }
                }
              },
              "else": {
                "properties": {
                  "supported": {
                    "type": "boolean"
                  }
                }
              }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "limit": {
      "allOf": [
        {
          "$ref": "#/$defs/evidence"
        },
        {
          "type": "object",
          "required": [
            "name",
            "value",
            "unit"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "unit": {
              "enum": [
                "paise",
                "days",
                "hours",
                "count"
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "rail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rail_id",
        "display_name",
        "hyperswitch_connector",
        "capabilities",
        "limits"
      ],
      "properties": {
        "rail_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "hyperswitch_connector": {
          "description": "The Hyperswitch connector this rail is, or null. Networks, schemes and protocols are not connectors.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/limit"
          }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "streamHead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream",
        "length",
        "head"
      ],
      "properties": {
        "stream": {
          "type": "string",
          "minLength": 1
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "head": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "verification": {
      "description": "The latest re-check of this row's quote against the page it cites. `unfetchable` says the source could not be read (never that the quote is wrong); `not_found` and `document_changed` say it could and the quote is gone.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "detail",
            "checked_on",
            "quote_current",
            "evidence_hash",
            "checks",
            "changes"
          ],
          "properties": {
            "result": {
              "enum": [
                "verified",
                "verified_fragments",
                "verified_by_copy",
                "not_found",
                "document_changed",
                "unfetchable"
              ]
            },
            "detail": {
              "type": "string"
            },
            "checked_on": {
              "$ref": "#/$defs/date"
            },
            "quote_current": {
              "type": "boolean",
              "description": "False if the row's quote was edited after this check."
            },
            "evidence_hash": {
              "$ref": "#/$defs/sha256"
            },
            "checks": {
              "type": "integer",
              "minimum": 1
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "on",
                  "from",
                  "to"
                ],
                "properties": {
                  "on": {
                    "$ref": "#/$defs/date"
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "observation": {
      "description": "What the probe named by `probe_id` most recently found for this row, from the latest conclusive run (a 2xx or a semantic 4xx; an outage or bad credential never counts). `agrees` is false when the rail now answers differently from the row: the row is stale, or was wrong.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "probe_id",
            "runs",
            "latest",
            "changes"
          ],
          "properties": {
            "probe_id": {
              "type": "string",
              "minLength": 1
            },
            "runs": {
              "type": "integer",
              "minimum": 1
            },
            "latest": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "supported",
                "observed_on",
                "evidence_hash",
                "environment",
                "agrees"
              ],
              "properties": {
                "supported": {
                  "type": "boolean"
                },
                "observed_on": {
                  "$ref": "#/$defs/date"
                },
                "evidence_hash": {
                  "$ref": "#/$defs/sha256"
                },
                "environment": {
                  "enum": [
                    "sandbox",
                    "live"
                  ]
                },
                "agrees": {
                  "type": "boolean"
                }
              }
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "on",
                  "from",
                  "to"
                ],
                "properties": {
                  "on": {
                    "$ref": "#/$defs/date"
                  },
                  "from": {
                    "type": "boolean"
                  },
                  "to": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "definition",
        "rails"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 20
        },
        "rails": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        }
      }
    }
  }
}
