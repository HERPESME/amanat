# Copy to .env and fill in ONE of these. Never commit .env — it is gitignored.
#
# The model holds no authority in this system: every action it proposes is
# judged by the policy engine before it reaches a rail. So the provider is a
# free choice, and the governed core runs with neither key set.

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# --- Payment rails (none required for the demo or the test suite) ---
# Razorpay test mode — https://dashboard.razorpay.com/app/website-app-settings/api-keys
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=

# Cashfree sandbox — pre-auth is NOT self-serve, raise a support request first
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=

# Setu UAT — ask for purpose code 77 (goods); their sandbox documents 76
# SETU_CLIENT_ID=
# SETU_CLIENT_SECRET=
